{
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet restore:*)",
      "Bash(cd:*)",
      "Bash(python:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "echo \"$(git branch --show-current 2>/dev/null | sed 's/^/🌿 /') $(basename $(pwd) | sed 's/^/📁 /')\"",
    "padding": 1
  }
}
